{
  "name": "proj_uinhome",
  "version": "1.33.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:check:db": "node --import tsx/esm scripts/payload/checks/check-db-connection.ts",
    "cms:check:pages": "node --import tsx/esm scripts/payload/checks/check-pages.ts",
    "cms:check:home": "node --import tsx/esm scripts/payload/checks/check-home.ts",
    "cms:check:products": "node --import tsx/esm scripts/payload/checks/check-prod.ts",
    "cms:seed:base": "node --import tsx/esm scripts/payload/seed/seed.ts",
    "cms:seed:images": "node --import tsx/esm scripts/payload/seed/seed-images.ts",
    "cms:seed:cases": "node --import tsx/esm scripts/payload/seed/seed-case-studies.ts",
    "cms:seed:knowledge-base": "node --import tsx/esm scripts/payload/seed/seed-knowledge-base.ts",
    "cms:backup:local": "bash scripts/payload/ops/backup-all.sh",
    "cms:snapshot:export": "node --import tsx/esm scripts/payload/ops/export-cms-snapshot.ts",
    "cms:snapshot:restore": "node --import tsx/esm scripts/payload/ops/restore-cms-snapshot.ts",
    "cms:publish:all": "node --import tsx/esm scripts/payload/ops/publish.ts all",
    "cms:publish:pages": "node --import tsx/esm scripts/payload/ops/publish.ts pages",
    "cms:publish:products": "node --import tsx/esm scripts/payload/ops/publish.ts products",
    "cms:publish:cases": "node --import tsx/esm scripts/payload/ops/publish.ts caseStudies",
    "cms:data:migrate:site-settings-cta": "node --import tsx/esm scripts/payload/migrations/data/migrate-site-settings-cta.ts",
    "cms:data:migrate:footer:contact-items": "node --import tsx/esm scripts/payload/migrations/data/migrate-footer-contact-items.ts",
    "cms:data:migrate:footer:contact-info": "node --import tsx/esm scripts/payload/migrations/data/migrate-footer-contact-info.ts",
    "cms:data:migrate:footer:legal-labels": "node --import tsx/esm scripts/payload/migrations/data/migrate-footer-legal-labels.ts",
    "cms:data:migrate:cookie-privacy-link:localized": "node --import tsx/esm scripts/payload/migrations/data/migrate-cookie-privacy-link-localized.ts",
    "cms:data:migrate:cookie-policy-disclosure": "node --import tsx/esm scripts/payload/migrations/data/migrate-cookie-policy-disclosure.ts",
    "cms:schema:create": "payload migrate:create",
    "cms:schema:migrate": "payload migrate",
    "cms:schema:status": "payload migrate:status",
    "cms:schema:push:dev": "PAYLOAD_SCHEMA_PUSH=true node --import tsx/esm scripts/payload/dev/push-schema.ts",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version",
    "changelog": "node scripts/generate-changelog.cjs",
    "docker:build": "docker build -f ops/docker/Dockerfile -t proj-unihome-app:local .",
    "docker:up:dev:db": "docker compose --project-directory . -f ops/docker/compose.dev.yml up -d",
    "docker:up:prod": "docker compose --project-directory . -f ops/docker/compose.prod.yml --env-file .env.production up -d",
    "deploy:bundle": "bash ops/deploy/create-deploy-bundle.sh --profile init",
    "deploy:bundle:init": "bash ops/deploy/create-deploy-bundle.sh --profile init",
    "deploy:bundle:update": "bash ops/deploy/create-deploy-bundle.sh --profile update",
    "deploy:aliyun:bootstrap": "bash ops/deploy/remote/aliyun-bootstrap.sh --host aliyun",
    "deploy:aliyun:init": "bash ops/deploy/remote/aliyun-deploy.sh --host aliyun --mode init",
    "deploy:aliyun:update": "bash ops/deploy/remote/aliyun-deploy.sh --host aliyun --mode update"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/typography": "^0.5.19",
    "cli-color": "^2.0.4",
    "dotenv": "^17.4.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.4.11",
    "next": "15.4.11",
    "next-intl": "^4.7.0",
    "next-themes": "^0.2.1",
    "nodemailer": "^8.0.5",
    "payload": "^3.0.0",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.3.3"
  }
}
