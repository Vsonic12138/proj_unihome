# 可选：如果你在本地预构建镜像并上传到服务器，可以在这里指定镜像名
APP_IMAGE=proj-unihome-app:local

# 站点正式访问域名，用于前端生成媒体资源和预览链接
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# Payload / Next 生产密钥，必须替换为高强度随机字符串
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-another-long-random-string

# 生产环境建议关闭应用启动时自动推送 schema
PAYLOAD_SCHEMA_PUSH=false

# PostgreSQL 容器初始化参数
POSTGRES_DB=proj_unihome
POSTGRES_USER=proj_unihome
POSTGRES_PASSWORD=replace-with-a-strong-password

# 应用连接 PostgreSQL 时使用 Docker 内部服务名 postgres
DATABASE_URI=postgresql://proj_unihome:replace-with-a-strong-password@postgres:5432/proj_unihome

# Turnstile 验证码（生产环境建议启用）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...

# 工单邮件通知：三选一，生产环境不要混用

# 方案 A（推荐）：Webhook 邮件转发
TICKET_EMAIL_WEBHOOK_URL=https://your-webhook.example.com/ticket-email
TICKET_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret

# 方案 B：直接 SMTP 发信（推荐优先评估阿里云 Direct Mail）
# China (Hangzhou) 官方 SMTP 地址示例：smtpdm.aliyun.com
# 官方可用端口：25、80、465（SSL）
# 如果运行在 ECS，官方建议未启用 SSL 时优先使用 80，启用 SSL 时使用 465
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=80
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# TICKET_EMAIL_TO=ops@example.com
# TICKET_EMAIL_FROM=UniHome <noreply@example.com>

# 方案 C：直接调用 Resend API
# RESEND_API_KEY=re_xxxxxxxxx
# TICKET_EMAIL_TO=ops@example.com
# TICKET_EMAIL_FROM=UniHome <noreply@example.com>
