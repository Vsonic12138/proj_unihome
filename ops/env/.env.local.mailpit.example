# 本地开发示例：Next.js + Payload + 本地 Postgres + Mailpit

# 核心安全秘钥（本地可使用测试值，生产必须替换）
PAYLOAD_SECRET=please-change-me-to-a-long-random-string
PREVIEW_SECRET=please-change-me-preview-secret

# 本地数据库
DATABASE_URI=postgresql://proj_unihome:proj_unihome_password@localhost:5432/proj_unihome?sslmode=disable

# 本地站点地址
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 本地 SMTP（Mailpit）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TICKET_EMAIL_TO=test@unihome.local
TICKET_EMAIL_FROM=UniHome Local <noreply@unihome.local>

# 本地不强制 Turnstile，可留空
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 本地通常不使用 Webhook
TICKET_EMAIL_WEBHOOK_URL=
TICKET_EMAIL_WEBHOOK_SECRET=
