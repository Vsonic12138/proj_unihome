# 核心安全秘钥（用于会话加密、JWT 签名等，生产环境必须替换为高强度随机字符串）
PAYLOAD_SECRET=please-change-me-to-a-long-random-string

# 数据库连接 URI
# 格式：postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]?参数
DATABASE_URI=postgresql://proj_unihome:proj_unihome_password@localhost:5432/proj_unihome?sslmode=disable

# 站点对外访问路径（用于前端组件获取后端接口、媒体文件拼接完整 URL 服务地址）
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 草稿预览（Next.js Draft Mode）密钥：用于 /api/preview?secret=...
PREVIEW_SECRET=please-change-me-preview-secret

# 工单提交邮件转发（可选，但强烈建议生产环境配置）
# 方式 1（推荐）：转发到你自己的邮件网关/函数服务
# - 你的服务收到 JSON 后负责发送邮件（更灵活，也更容易替换供应商）
TICKET_EMAIL_WEBHOOK_URL=
TICKET_EMAIL_WEBHOOK_SECRET=

# 方式 1.5：直接使用 SMTP（本地可配合 Mailpit 测试）
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TICKET_EMAIL_TO=
TICKET_EMAIL_FROM=

# Turnstile captcha（增强防刷，生产环境建议启用）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 方式 2：Resend（需要服务器能访问外网）
# RESEND_API_KEY=
# TICKET_EMAIL_TO=ops@example.com
# TICKET_EMAIL_FROM="UniHome <noreply@example.com>"
