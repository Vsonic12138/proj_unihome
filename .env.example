# 核心安全秘钥（用于会话加密、JWT 签名等，生产环境必须替换为高强度随机字符串）
PAYLOAD_SECRET=please-change-me-to-a-long-random-string

# 数据库连接 URI
# 格式：postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]?参数
DATABASE_URI=postgresql://proj_unihome:proj_unihome_password@localhost:5432/proj_unihome?sslmode=disable

# 站点对外访问路径（用于前端组件获取后端接口、媒体文件拼接完整 URL 服务地址）
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 草稿预览（Next.js Draft Mode）密钥：用于 /api/preview?secret=...
PREVIEW_SECRET=please-change-me-preview-secret
